      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/0e4dfb5d-74e1-4548-a2d7-352ea835e255.json",
      "reading": "崇眞實棄假謊略說",
      "status": "依原圖留讀",
      "reason": "原圖見謊字右上草頭及略字左田右各。"
    },
    {
      "image": 8,
      "side": "single",
      "column": 4,
      "source_image_sha256": "3c63c5911e0cadf216444909a8933a583be75e67a9e8fc4dbfd775ec47281a35",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/4cf9595b-30bd-4ead-93bf-7d439ab49307.json",
      "reading": "粧",
      "status": "依原圖留讀",
      "reason": "欄首見米旁與庄組合。"
    },
    {
      "image": 8,
      "side": "single",
      "column": 4,
      "source_image_sha256": "3c63c5911e0cadf216444909a8933a583be75e67a9e8fc4dbfd775ec47281a35",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/4cf9595b-30bd-4ead-93bf-7d439ab49307.json",
      "reading": "說他要",
      "status": "依原圖留讀",
      "reason": "末欄三字清楚，次欄再起他不作衍字處理。"
    },
    {
      "image": 11,
      "side": "single",
      "column": 2,
      "source_image_sha256": "1585e593f16b352edf86aa94d22db56f1c0db35ddb9dab2ccf85d5e3100a8a08",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/4c35b3f3-24d2-4206-b801-2ae37a47940c.json",
      "reading": "我是同",
      "status": "依原圖留讀",
      "reason": "開頭可辨我、是兩字。"
    },
    {
      "image": 13,
      "side": "single",
      "column": 3,
      "source_image_sha256": "6f06931da5875308dadf1938796aca9c885075abbc64cc103f322ff6f313ac1a",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/4f33cc94-27a9-4f51-b4d7-1a7d67196dc1.json",
      "reading": "也。○再者",
      "status": "依原圖留讀",
      "reason": "字側小圈與等字高空圈有清楚位置差異。"
    }
  ]
