    {
      "image": 14,
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/d36b6192-0391-4b98-ac42-7cc9a191f9fa.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/d36b6192-0391-4b98-ac42-7cc9a191f9fa/full/2000,/0/default.jpg",
