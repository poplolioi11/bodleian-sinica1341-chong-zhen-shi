      "image": 6,
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/ec12904e-fc2c-40f6-b1ff-76ead0afae06.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/ec12904e-fc2c-40f6-b1ff-76ead0afae06/full/2000,/0/default.jpg",
      "label": "p. [4]",
