    {
      "image": 13,
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/4f33cc94-27a9-4f51-b4d7-1a7d67196dc1.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/4f33cc94-27a9-4f51-b4d7-1a7d67196dc1/full/2000,/0/default.jpg",
      "label": "p. [11]",
