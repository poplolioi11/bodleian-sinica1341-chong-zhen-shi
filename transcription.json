              "column_anchor": 8,
              "color": "unknown"
            }
          ]
        }
      ],
      "issues": [],
      "observations": "單幅：第三欄「騙」印淺。第六欄「已」後留空，下一欄起問答。"
    },
    {
      "image": 10,
